{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "an-form",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-09-01",
  // 주소는 이 도메인 하나다. Cloudflare 가 이 이름의 DNS 레코드를 직접
  // 관리한다(custom_domain). workers.dev 주소는 끈다 — 같은 앱에 이르는 문이
  // 둘이면 Access 애플리케이션도 둘을 각각 덮어야 하고, 하나를 빠뜨리는
  // 순간 관리자 화면이 그 문으로 그대로 열린다.
  "routes": [{ "pattern": "anform.jaehyun.dev", "custom_domain": true }],
  "workers_dev": false,
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    // 설문 링크는 Worker 가 먼저 받는다 — 카카오톡 스크래퍼가 보는 HTML 에
    // 그 설문의 이름을 넣은 og: 태그를 실어 보내야 하기 때문이다
    // (src/server/shell.ts). 첫 화면(/)도 같은 이유로 Worker 를 거친다:
    // 카드의 og:url 은 절대 주소여야 하는데 배포 도메인은 코드가 아니라
    // 바로 아래 routes 에 있어서, 요청 주소를 보고 채우는 수밖에 없다.
    // 나머지 경로는 자산이 그대로 나간다.
    "run_worker_first": ["/api/*", "/s/*", "/"],
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "an-form",
      // 바인딩은 DB 하나뿐이다. 코드가 이 데이터베이스를 부르는 이름이
      // c.env.DB 하나이므로(src/server/db/**), 같은 데이터베이스를 다른
      // 바인딩 이름으로 하나 더 매달면 아무도 쓰지 않는 바인딩이 배포에만
      // 실린다 — `wrangler d1 create` 가 제안한 an_form 항목이 그것이었다.
      "database_id": "5965108e-99c5-42da-a981-8b529bb5b922"
    }
  ],
  "observability": { "enabled": true },
  "vars": {
    "ADMIN_AUTH_MODE": "access",
    // Zero Trust 대시보드 > Access > Applications 에서 만든 팀의 도메인.
    "ACCESS_TEAM_DOMAIN": "hyunjae.cloudflareaccess.com",
    // 같은 화면에서 /admin, /api/admin 애플리케이션을 만든 뒤 그 Application Audience (AUD) Tag를 붙여넣는다.
    "ACCESS_AUD": "a64a44f9be9a076a10d2946ac1fb857ecb1e6ff9d8ba82a9c584dfce5ac777df"
  }
}
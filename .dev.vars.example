# 로컬 개발용 예시. `.dev.vars`로 복사해서 쓴다(.dev.vars 는 git에 커밋하지 않는다).
#   cp .dev.vars.example .dev.vars

# 관리자 인증을 로컬 개발 모드로 켠다. 이 값이 없으면 wrangler dev 는
# ADMIN_AUTH_MODE: "access" 로 자동 전환되어 관리자 API 가 전부 500 을 낸다.
ADMIN_AUTH_MODE=insecure-local

# 익명성 해싱(브라우저 키·IP·UA)에 쓰는 시크릿. 로컬 값은 아무 문자열이어도 된다.
HMAC_SECRET=local-dev-secret
